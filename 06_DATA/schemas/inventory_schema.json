  "properties": {
    "sku": {"type": "string"},
    "shelf_id": {"type": "string"},
    "current_weight_grams": {"type": "number"},
    "estimated_quantity": {"type": "integer"},
    "threshold": {"type": "integer"},
    "status": {"type": "string"},
    "confidence": {"type": "number"}
  }
}
