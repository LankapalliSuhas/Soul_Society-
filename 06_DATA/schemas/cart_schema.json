{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "netra://schemas/cart/v1",
  "title": "NETRA Cart Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "cart_id",
    "timestamp",
    "tare_weight_grams",
    "current_weight_grams",
    "weight_change_grams",
    "item_burden",
    "confidence"
  ],
  "properties": {
    "cart_id": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "tare_weight_grams": {
      "type": "number",
      "minimum": 0
    },
    "current_weight_grams": {
      "type": "number",
      "minimum": 0
    },
    "weight_change_grams": {
      "type": "number"
    },
    "estimated_item_count": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "item_burden": {
      "type": "string",
      "enum": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    }
  }
}