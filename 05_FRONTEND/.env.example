# Base URL for REST API calls (see src/services/api.js)
VITE_API_BASE_URL=http://localhost:8000/api

# WebSocket URL for the live events feed (see src/websocket/liveEvents.js)
VITE_WS_URL=ws://localhost:8000/ws

# When true, api.js and liveEvents.js serve generated mock data/events
# instead of hitting the network. Flip to false once the backend and
# api_contract.json / event_schema.json are available.
VITE_USE_MOCK=true
